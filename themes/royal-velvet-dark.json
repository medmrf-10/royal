  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#f8f8f250", "fontStyle": "italic" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#ff80c0" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#ff80c0" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#ffd580" }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#ffc080" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#a0ff80" }
    },
    {
      "name": "Function Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#ffc080" }
    },
    {
      "name": "Type / Class",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#9580ff" }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": { "foreground": "#80d5ff" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#f8f8f2" }
    },
    {
      "name": "Constant",
      "scope": ["constant.language", "constant.character", "variable.other.constant"],
      "settings": { "foreground": "#9580ff" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ffc080" }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": { "foreground": "#9580ff" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.variable.property", "variable.other.object.property"],
      "settings": { "foreground": "#80d5ff" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#f8f8f280" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#ff80c0" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#a0ff80" }
    },
    {
      "name": "Attribute Value",
      "scope": ["meta.attribute string", "string.quoted.double.html"],
      "settings": { "foreground": "#ffd580" }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#ffc080" }
    },
    {
      "name": "Decorator / Annotation",
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#ffd580" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#ff8080" }
    },

    {
      "name": "Markdown H1",
      "scope": ["heading.1.markdown", "markup.heading.1.markdown", "markup.heading.1.md", "heading.1.md"],
      "settings": { "foreground": "#ff80c0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown H2",
      "scope": ["heading.2.markdown", "markup.heading.2.markdown", "markup.heading.2.md", "heading.2.md"],
      "settings": { "foreground": "#ffc080", "fontStyle": "bold" }
    },
    {
      "name": "Markdown H3",
      "scope": ["heading.3.markdown", "markup.heading.3.markdown", "markup.heading.3.md", "heading.3.md"],
      "settings": { "foreground": "#ffd580", "fontStyle": "bold" }
    },
    {
      "name": "Markdown H4",
      "scope": ["heading.4.markdown", "markup.heading.4.markdown", "markup.heading.4.md", "heading.4.md"],
      "settings": { "foreground": "#a0ff80", "fontStyle": "bold" }
    },
    {
      "name": "Markdown H5",
      "scope": ["heading.5.markdown", "markup.heading.5.markdown", "markup.heading.5.md", "heading.5.md"],
      "settings": { "foreground": "#80d5ff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown H6",
      "scope": ["heading.6.markdown", "markup.heading.6.markdown", "markup.heading.6.md", "heading.6.md"],
      "settings": { "foreground": "#9580ff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ff80c0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold Punctuation",
      "scope": ["punctuation.definition.bold.markdown"],
      "settings": { "foreground": "#ff80c080" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#80d5ff", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Italic Punctuation",
      "scope": ["punctuation.definition.italic.markdown"],
      "settings": { "foreground": "#80d5ff80" }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw.string.markdown"],
      "settings": { "foreground": "#df80ff" }
    },
    {
      "name": "Markdown Inline Code Punctuation",
      "scope": ["punctuation.definition.raw.markdown"],
      "settings": { "foreground": "#df80ff80" }
    },
    {
      "name": "Markdown Fenced Code Block",
      "scope": ["markup.fenced_code.block.markdown", "fenced_code.block.language"],
      "settings": { "foreground": "#df80ff" }
    },
    {
      "name": "Markdown Link Text",
      "scope": ["string.other.link.title.markdown", "string.other.link.description.markdown"],
      "settings": { "foreground": "#a0ff80" }
    },
    {
      "name": "Markdown Link URL",
      "scope": ["markup.underline.link.markdown", "markup.underline.link.image.markdown"],
      "settings": { "foreground": "#ffc080" }
    },
    {
      "name": "Markdown Image Alt Text",
      "scope": ["string.other.link.description.image.markdown"],
      "settings": { "foreground": "#80d5ff" }
    },
    {
      "name": "Markdown List Marker",
      "scope": ["punctuation.definition.list.begin.markdown", "markup.list.unnumbered.markdown", "markup.list.numbered.markdown"],
      "settings": { "foreground": "#ff80c0" }
    },
    {
      "name": "Markdown Blockquote",
      "scope": ["markup.quote.markdown"],
      "settings": { "foreground": "#f8f8f299", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Blockquote Punctuation",
      "scope": ["punctuation.definition.quote.begin.markdown"],
      "settings": { "foreground": "#ff8080" }
    },
    {
      "name": "Markdown Horizontal Rule",
      "scope": ["meta.separator.markdown"],
      "settings": { "foreground": "#ffc080" }
    },
    {
      "name": "Markdown Strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#f8f8f250" }
    },
    {
      "name": "Markdown YAML Front Matter",
      "scope": ["meta.embedded.block.frontmatter"],
      "settings": { "foreground": "#f8f8f280" }
    },

    {
      "name": "JSON Property",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#80d5ff" }
    },
    {
      "name": "CSS Property",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css"],
      "settings": { "foreground": "#80d5ff" }
    },
    {
      "name": "CSS Property Value",
      "scope": ["support.constant.property-value.css", "support.constant.color.css"],
      "settings": { "foreground": "#ffc080" }
    },
    {
      "name": "CSS Class Selector",
      "scope": ["entity.other.attribute-name.class.css"],
      "settings": { "foreground": "#a0ff80" }
    },
    {
      "name": "CSS ID Selector",
      "scope": ["entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#ffd580" }
    },
    {
      "name": "CSS Pseudo",
      "scope": ["entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css"],
      "settings": { "foreground": "#9580ff" }
    },
    {
      "name": "CSS Unit",
      "scope": ["keyword.other.unit.css"],
      "settings": { "foreground": "#ffc080" }
    },

    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#a0ff80" }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#ff8080" }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#ffd580" }
    },
    {
      "name": "Diff Range",
      "scope": ["meta.diff.range"],
      "settings": { "foreground": "#80d5ff" }
    }
  ]
}
